        <activity android:name=".GerenciarTreinosActivity" android:exported="false" />
        <activity android:name=".ExercicioActivity"      android:exported="false" />
        <activity android:name=".ExercicioDetalheActivity" android:exported="false" />
        <activity android:name=".VincularUsuarioTreinoActivity" android:exported="false" />

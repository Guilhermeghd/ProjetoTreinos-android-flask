<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/login">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#111111">

        <TextView
            android:id="@+id/txtUsuarioAtual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="usuario"
            android:textSize="11sp"
            android:textColor="#F8F8F8"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/txtTreinoNome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="treino"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EXERCÍCIOS"
        android:textSize="11sp"
        android:textColor="#555555"
        android:letterSpacing="0.15"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="4dp"/>

    <ListView
        android:id="@+id/lsvExerciciosChecklist"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:paddingTop="4dp"
        android:clipToPadding="false"
        />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFinalizarTreino"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="FINALIZAR TREINO"
        android:textColor="#000000"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:onClick="FinalizarTreinoClique"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:backgroundTint="#C8FF00"
        app:cornerRadius="12dp"/>

</LinearLayout>
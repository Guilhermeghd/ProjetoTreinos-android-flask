<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/fundo2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#111111">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADMINISTRADOR"
                    android:textSize="11sp"
                    android:textColor="#111192"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="4dp"/>


            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Sair"
                android:textColor="#888888"
                android:textSize="13sp"
                android:onClick="sair"
                app:backgroundTint="#1A1A1A"
                app:strokeColor="#2A2A2A"
                app:strokeWidth="1dp"
                app:cornerRadius="18dp"/>

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" MONTE OS TREINOS"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.05"
                android:layout_marginBottom="35dp"/>


            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nome do treino"
                android:layout_marginBottom="16dp"
                app:boxBackgroundColor="#1A1A1A"
                app:boxStrokeColor="#00000000"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:hintTextColor="#7A7A7A"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textCursorDrawable="@null"/>

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Descrição"
                android:layout_marginBottom="24dp"
                app:boxBackgroundColor="#1A1A1A"
                app:boxStrokeColor="#00000000"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:hintTextColor="#7A7A7A"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtDescricao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textCursorDrawable="@null"/>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selecionar Exercícios"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <ListView
                android:id="@+id/lsvExerciciosVinculo"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="#999999"
                android:divider="#FFFFFF"
                android:dividerHeight="1dp"
                android:padding="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInserir"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Inserir Treino"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:onClick="InserirClique"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                app:backgroundTint="#003BF2"
                app:cornerRadius="16dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAtualizar"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Atualizar Treino"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:onClick="AtualizarClique"
                android:layout_marginBottom="12dp"
                app:backgroundTint="#4BCC00"
                app:cornerRadius="16dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExcluir"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Excluir Treino"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:onClick="ExcluirClique"
                app:backgroundTint="#F44336"
                app:cornerRadius="16dp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>